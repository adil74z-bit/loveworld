{
  "rules": {
    ".read": false,
    ".write": false,
    "couples": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[a-f0-9]{64}$/)",
        "db": {
          "shared": {
            "world": {
              ".read": "auth != null",
              ".write": "auth != null",
              ".validate": "newData.hasChildren(['disc', 'pins', 'rev']) && newData.child('pins').numChildren() <= 100 && newData.child('rev').isNumber()"
            },
            "house": {
              ".read": "auth != null",
              ".write": "auth != null",
              ".validate": "newData.hasChildren(['wall', 'floor', 'mood', 'items', 'rev']) && newData.child('items').numChildren() <= 80 && newData.child('rev').isNumber() && newData.child('mood').val().matches(/^(day|evening|night)$/)"
            }
          },
          "players": {
            "$uid": {
              ".read": "auth != null",
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.hasChildren(['n', 'a', 'x', 'z', 's', 't']) && newData.child('n').isString() && newData.child('n').val().length <= 14 && newData.child('a').numChildren() == 4 && newData.child('x').isNumber() && newData.child('z').isNumber() && newData.child('t').isNumber()"
            }
          }
        },
        "rooms": {
          "$room": {
            "presence": {
              ".read": "auth != null",
              ".validate": "newData.numChildren() <= 2",
              "$uid": {
                ".write": "auth != null && auth.uid === $uid",
                ".validate": "newData.hasChildren(['n', 'a', 'x', 'z', 'y', 'r', 's', 'v', 'q', 'u']) && newData.child('n').isString() && newData.child('n').val().length <= 14 && newData.child('a').numChildren() == 4 && newData.child('x').isNumber() && newData.child('z').isNumber() && newData.child('y').isNumber() && newData.child('r').isNumber() && newData.child('s').isString() && newData.child('v').isNumber() && newData.child('q').isNumber() && newData.child('u').val() === auth.uid"
              }
            },
            "chat": {
              ".read": "auth != null",
              ".indexOn": ["ts"],
              "$message": {
                ".write": "auth != null && !data.exists() && newData.child('p').val() === auth.uid",
                ".validate": "newData.hasChildren(['p', 'd', 'ts']) && newData.child('d').hasChildren(['n', 't']) && newData.child('d').child('n').isString() && newData.child('d').child('n').val().length <= 14 && newData.child('d').child('t').isString() && newData.child('d').child('t').val().length <= 120 && newData.child('ts').isNumber()"
              }
            }
          }
        }
      }
    }
  }
}